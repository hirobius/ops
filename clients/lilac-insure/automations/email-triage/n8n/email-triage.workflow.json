{
  "_comment": "n8n workflow draft — Outlook trigger → Execute Command (calls classify.mjs via run.mjs) → Switch on category → Update Message with Outlook category. Import into n8n once hosting is decided. Adjust nodeMailbox + path-to-repo for the host environment.",
  "_status": "draft-not-yet-imported",
  "_lastUpdated": "2026-05-05",
  "_promotionChecklist": [
    "Decide n8n hosting (self-host vs. n8n Cloud)",
    "Provision Microsoft Graph creds (MS_GRAPH_*) for the target mailbox",
    "Confirm absolute path to repo on n8n host (REPO_ROOT env var below)",
    "Run a single thread end-to-end with mode=test in automation-config.json",
    "Verify _log.jsonl receives both the classify result and the dry-run send"
  ],

  "name": "Lilac — Email Triage",
  "nodes": [
    {
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "filters": { "readStatus": "unread" }
      },
      "id": "outlook-trigger",
      "name": "Outlook (new mail)",
      "type": "n8n-nodes-base.microsoftOutlookTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "credentials": { "microsoftOutlookOAuth2Api": { "id": "REPLACE_WITH_OUTLOOK_CRED_ID", "name": "Outlook (administration@lilacinsure.com)" } }
    },
    {
      "parameters": {
        "command": "=node $env.REPO_ROOT/clients/lilac-insure/automations/email-triage/run.mjs --classify-stdin",
        "options": {
          "stdin": "={{ JSON.stringify({ from: $json.from?.emailAddress?.address ?? '', subject: $json.subject ?? '', body: $json.bodyPreview ?? '' }) }}"
        }
      },
      "id": "classify-cmd",
      "name": "Classify (run.mjs)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "const out = JSON.parse($json.stdout); return [{ json: { ...$('Outlook (new mail)').item.json, classification: out } }];"
      },
      "id": "merge-classification",
      "name": "Merge classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            { "value2": "noise",        "output": 0 },
            { "value2": "vendor-ops",   "output": 1 },
            { "value2": "carrier-ops",  "output": 2 },
            { "value2": "compliance",   "output": 3 },
            { "value2": "lead",         "output": 4 },
            { "value2": "claim",        "output": 5 },
            { "value2": "service",      "output": 6 },
            { "value2": "renewal",      "output": 7 },
            { "value2": "retention",    "output": 8 },
            { "value2": "onboarding",   "output": 9 },
            { "value2": "quoting",      "output": 10 },
            { "value2": "internal",     "output": 11 }
          ]
        },
        "value1": "={{ $json.classification.category }}",
        "dataType": "string"
      },
      "id": "switch-category",
      "name": "Route by category",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [960, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "messageId": "={{ $('Outlook (new mail)').item.json.id }}",
        "updateFields": {
          "categories": "={{ ['lilac-' + $('Merge classification').item.json.classification.category] }}"
        }
      },
      "id": "apply-outlook-category",
      "name": "Apply Outlook category",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 1,
      "position": [1240, 300],
      "credentials": { "microsoftOutlookOAuth2Api": { "id": "REPLACE_WITH_OUTLOOK_CRED_ID", "name": "Outlook (administration@lilacinsure.com)" } },
      "notes": "Connect every Switch output to this node. n8n editor will fan-in the connections."
    }
  ],

  "connections": {
    "Outlook (new mail)":      { "main": [[{ "node": "Classify (run.mjs)", "type": "main", "index": 0 }]] },
    "Classify (run.mjs)":      { "main": [[{ "node": "Merge classification", "type": "main", "index": 0 }]] },
    "Merge classification":    { "main": [[{ "node": "Route by category", "type": "main", "index": 0 }]] },
    "Route by category":       { "main": [
      [{ "node": "Apply Outlook category", "type": "main", "index": 0 }],
      [{ "node": "Apply Outlook category", "type": "main", "index": 0 }],
      [{ "node": "Apply Outlook category", "type": "main", "index": 0 }],
      [{ "node": "Apply Outlook category", "type": "main", "index": 0 }],
      [{ "node": "Apply Outlook category", "type": "main", "index": 0 }],
      [{ "node": "Apply Outlook category", "type": "main", "index": 0 }],
      [{ "node": "Apply Outlook category", "type": "main", "index": 0 }],
      [{ "node": "Apply Outlook category", "type": "main", "index": 0 }],
      [{ "node": "Apply Outlook category", "type": "main", "index": 0 }],
      [{ "node": "Apply Outlook category", "type": "main", "index": 0 }],
      [{ "node": "Apply Outlook category", "type": "main", "index": 0 }],
      [{ "node": "Apply Outlook category", "type": "main", "index": 0 }]
    ]}
  },

  "active": false,
  "settings": { "saveExecutionProgress": true, "saveDataSuccessExecution": "all", "saveDataErrorExecution": "all" }
}
