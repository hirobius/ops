{
  "name": "@hirobius/ops",
  "description": "Hirobius Ops — agency operations dashboard (clients, tasks, build telemetry). Consumes @hirobius/design-system for UI.",
  "private": true,
  "version": "0.3.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "type": "module",
  "module": "./dist/hirobius-ui.js",
  "types": "./src/index.ts",
  "sideEffects": [
    "**/*.css",
    "./src/styles/**",
    "./dist/tokens.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/hirobius-ui.js",
      "default": "./dist/hirobius-ui.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens": {
      "types": "./src/app/design-system/tokens.ts",
      "import": "./dist/tokens.js",
      "default": "./dist/tokens.js"
    },
    "./cn": {
      "types": "./src/lib/utils.ts",
      "import": "./dist/cn.js",
      "default": "./dist/cn.js"
    },
    "./manifest": {
      "types": "./public/hds-manifest.json",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "public/hds-manifest.json"
  ],
  "scripts": {
    "_comment:a11y-high-value": "The following check:* validators are high-value accessibility checks that catch real violations (check:focus found 1 missing focus class). Kept dormant/manual-only to avoid pre-commit performance regression. Candidates to wire into pretest after CI stability review.",
    "_comment:link-integrity": "check:doc-refs and check:routes both validate internal link integrity (different surfaces: doc refs vs route links). Kept dormant/manual-only to prevent pre-commit cascade.",
    "_comment:security-baseline": "check:security validates OWASP baseline patterns. Dormant/manual-only — candidate for integration into security-focused CI lane, not pretest.",
    "_comment:token-integrity": "check:css-values, check:token-structure validate token system correctness. Dormant/manual-only due to overlapping scope with check:fast and existing token validators.",
    "assets:convert": "node scripts/convert-incoming-assets.mjs",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "audit:gate-replaceability": "node scripts/audit-gate-replaceability.mjs --summary",
    "audit:soft-gates": "node scripts/audit-soft-gates.mjs --summary",
    "audit:sbom": "node scripts/audit-sbom.mjs",
    "audit:sidecar": "node scripts/generate-security-posture.mjs",
    "audit:style-dictionary": "bash scripts/poc/style-dictionary-poc/run.sh",
    "bot": "node scripts/discord-bot.mjs",
    "build": "vite build --configLoader native",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr-cache --configLoader native",
    "build:prerender": "pnpm build && pnpm build:ssr && node scripts/prerender.mjs",
    "catalog": "node scripts/generate-visual-catalog.mjs",
    "changelog:generate": "node scripts/generate-changelog.mjs",
    "changeset:add": "echo 'Install @changesets/cli (pnpm add -D @changesets/cli) to run: changeset add'",
    "changeset:version": "echo 'Install @changesets/cli (pnpm add -D @changesets/cli) to run: changeset version'",
    "check": "pnpm check:full",
    "check:a11y": "pnpm lint --rule '{\"jsx-a11y/alt-text\":\"error\",\"jsx-a11y/img-redundant-alt\":\"error\"}'",
    "check:attributions": "node scripts/check-attributions.mjs",
    "check:code-connect": "node scripts/check-code-connect.mjs",
    "check:colors": "node scripts/check-hardcoded-colors.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:doc-refs": "node scripts/check-link-integrity.mjs --doc-refs-only",
    "check:doc-structure": "node scripts/check-doc-structure.mjs",
    "check:docs": "node scripts/check-frozen-demos.mjs",
    "check:exemptions": "node scripts/check-exemptions.mjs",
    "check:fast": "node scripts/build-roadmap-data.mjs && pnpm typecheck && pnpm check:docs && pnpm exec editorconfig-checker && node scripts/check-tier-bypass.mjs && node scripts/check-link-integrity.mjs --doc-refs-only && node scripts/check-link-integrity.mjs --route-links-only && node scripts/check-registry.mjs",
    "check:focus": "node scripts/check-focus-states.mjs",
    "check:format": "pnpm exec lint-staged",
    "check:full": "pnpm typecheck && node scripts/audit-pages.mjs && pnpm check:docs && node scripts/check-doc-structure.mjs && node scripts/check-contrast.mjs && node scripts/check-focus-states.mjs && node scripts/check-reduced-motion.mjs && node scripts/check-unresponsive-grids.mjs && node scripts/check-page-shell.mjs && node scripts/check-motion.mjs && pnpm exec editorconfig-checker && node scripts/check-hardcoded-colors.mjs && node scripts/check-tier-bypass.mjs && node scripts/check-link-integrity.mjs && node scripts/check-og-meta.mjs && node scripts/check-security-baseline.mjs && node scripts/check-attributions.mjs && node scripts/check-exemptions.mjs && node scripts/check-registry.mjs",
    "check:grids": "node scripts/check-unresponsive-grids.mjs",
    "check:knip": "knip",
    "check:knip-ratchet": "knip --max-issues 60",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:lockfile": "pnpm install --frozen-lockfile --offline --prefer-offline --ignore-scripts --silent 2>/dev/null || (echo 'Lockfile drift: run pnpm install' && exit 1)",
    "check:micromotion": "node scripts/check-motion.mjs",
    "check:mojibake": "pnpm exec editorconfig-checker",
    "check:motion": "node scripts/check-reduced-motion.mjs",
    "check:page-shell": "node scripts/check-page-shell.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "check:release": "pnpm check:full && pnpm build && node scripts/check-route-smoke.mjs && pnpm perf:budget && pnpm test:a11y && pnpm test:visual && pnpm test:responsive && pnpm test:collision",
    "check:route-smoke": "node scripts/check-route-smoke.mjs",
    "check:routes": "node scripts/check-link-integrity.mjs --route-links-only",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:security": "node scripts/check-security-baseline.mjs",
    "check:semantic-report": "node scripts/record-health.mjs",
    "check:tailwind": "pnpm lint --rule '{\"tailwindcss/no-custom-classname\":\"error\"}'",
    "check:tailwind-arbitrary": "pnpm lint --rule '{\"tailwindcss/no-arbitrary-value\":\"error\"}'",
    "check:tier-bypass": "node scripts/check-tier-bypass.mjs",
    "check:tokens": "node scripts/check-hardcoded-colors.mjs && pnpm lint --rule '{\"tailwindcss/no-custom-classname\":\"error\"}' && node scripts/check-tier-bypass.mjs",
    "check:type-coverage": "pnpm exec type-coverage --at-least 99.9",
    "clone:page": "node scripts/page-clone.mjs",
    "closure:plan": "node scripts/run-gates.mjs --channel pre-commit --emit-inventory docs/guardrails/full-strictness-inventory.json && node scripts/generate-closure-plan.mjs",
    "closure:plan:check": "node scripts/generate-closure-plan.mjs --check",
    "dev": "vite --configLoader native",
    "docs:changelogs": "node scripts/generate-component-changelogs.mjs",
    "docs:llms": "node scripts/generate-llms-txt.mjs",
    "figma:stream": "node scripts/llm-stream-bridge.mjs",
    "guardrail:firing-stats": "node scripts/refresh-firing-stats.mjs",
    "guardrail:learned-rules": "node scripts/promote-learned-rule.mjs --list",
    "guardrail:promote-rule": "node scripts/promote-learned-rule.mjs",
    "heal": "node scripts/self-heal.mjs",
    "heal:smoke": "node scripts/self-heal.mjs --smoke",
    "health-commit": "pnpm check:semantic-report && node scripts/print-health-commit.mjs",
    "health-log": "node scripts/update-journal.mjs",
    "health:record": "node scripts/record-health.mjs",
    "icons:sync": "node scripts/sync-icons.mjs",
    "knip": "knip",
    "knowledge:bookmarks": "node scripts/parse-bookmarks.mjs",
    "knowledge:youtube": "node scripts/youtube-knowledge.mjs",
    "knowledge:youtube:auth": "node scripts/youtube-knowledge.mjs --auth",
    "knowledge:youtube:digest": "node scripts/youtube-knowledge.mjs --digest",
    "lint": "eslint src scripts validators tests",
    "lint:fix": "eslint src scripts validators tests --fix",
    "llms:generate": "node scripts/generate-llms-txt.mjs",
    "manifest:generate": "node scripts/generate-script-index.mjs",
    "scripts:index": "node scripts/generate-script-index.mjs",
    "perf:budget": "node -e \"require('fs').readdirSync('.lighthouseci').filter(f=>f.startsWith('lhr-')).forEach(f=>require('fs').unlinkSync('.lighthouseci/'+f))\" 2>/dev/null; lhci collect --config=.lighthouserc.json && lhci assert --config=.lighthouserc.json; find . -maxdepth 1 -type d -name 'C:*' -exec rm -rf {} + 2>/dev/null; true",
    "prebuild": "node scripts/ensure-ops-data.mjs",
    "predev": "node scripts/ensure-ops-data.mjs",
    "prepare": "node scripts/setup-hooks.mjs",
    "pretest": "node scripts/check-registry.mjs && knip --no-exit-code",
    "pretypecheck": "node scripts/ensure-ops-data.mjs",
    "promote": "node scripts/promote.mjs",
    "roadmap:data": "node scripts/build-roadmap-data.mjs && node scripts/verify-roadmap-sync.mjs",
    "roadmap:verify": "node scripts/verify-roadmap-sync.mjs",
    "roadmap:watch": "node scripts/watch-roadmap.mjs",
    "scaffold:component": "node scripts/scaffold-component.mjs",
    "scan": "node scripts/batch-scan.mjs",
    "scan:local": "node scripts/batch-scan.mjs --local",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "strength": "node scripts/generate-strength-report.mjs",
    "strength:snapshot": "node scripts/generate-strength-report.mjs --history-snapshot",
    "sync:health": "node scripts/sync-system-health.mjs && node scripts/build-roadmap-data.mjs && node scripts/verify-roadmap-sync.mjs",
    "telegram": "node scripts/telegram-bot.mjs",
    "telemetry:report": "node scripts/telemetry-report.mjs",
    "test": "vitest run --passWithNoTests",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:collision": "playwright test tests/collision.spec.ts",
    "test:coverage": "vitest run --coverage",
    "test:figma": "npx tsx scripts/figma-sync.ts",
    "test:layout": "node scripts/check-route-coverage.mjs && playwright test tests/layout-integrity.spec.ts",
    "test:phase1": "node scripts/test-phase1.mjs",
    "test:prompts": "node scripts/test-prompt-regression.mjs",
    "test:responsive": "playwright test tests/responsive.spec.ts",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:visual:update": "playwright test tests/visual.spec.ts --update-snapshots",
    "test:watch": "vitest",
    "tokens": "node scripts/generate-llms-txt.mjs",
    "tokens:audit:pages": "node scripts/audit-pages.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:api": "tsc --noEmit -p tsconfig.api-check.json",
    "ui:lint": "node scripts/ui-lint.mjs",
    "visual-ingest": "node scripts/visual-ingest.mjs",
    "watch:guardrails": "nodemon --watch CLAUDE.md --watch .cursorrules --watch eslint.config.js --watch .github/workflows -e md,json,js,yml,yaml --exec \"node scripts/audit-guardrails.js\""
  },
  "dependencies": {
    "@hirobius/design-system": "^0.8.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/supabase-js": "^2.45.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.13.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.92.0",
    "@axe-core/playwright": "^4.11.1",
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@lhci/cli": "0.15.1",
    "@microsoft/api-extractor": "7.58.7",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vercel/node": "^5.8.22",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^4.1.0",
    "acorn": "^8.16.0",
    "acorn-jsx": "^5.3.2",
    "discord.js": "14.26.4",
    "editorconfig-checker": "^6.1.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "fast-check": "^4.7.0",
    "globals": "^17.6.0",
    "googleapis": "^171.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "knip": "^6.10.0",
    "lint-staged": "^17.0.2",
    "nodemon": "^3.1.14",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "react-docgen-typescript": "^2.4.0",
    "style-dictionary": "^5.4.0",
    "tailwindcss": "^4.2.4",
    "type-coverage": "^2.29.7",
    "typescript": "^6.0.2",
    "vite": "6.4.2",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^4.1.0",
    "youtube-transcript": "^1.3.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,mdx,css,scss,html,yaml,yml}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.2",
      "picomatch": ">=4.0.4",
      "uuid": "14.0.0",
      "postcss": "8.5.10"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
