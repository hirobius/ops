#!/usr/bin/env sh
# Post-commit: non-blocking background work.
#
# Re-run all pre-commit registry gates against HEAD and append per-gate
# results to docs/guardrails/firing-log.jsonl (unit 13g-12). If a gate
# that should have gated the commit fails post-commit, that means
# --no-verify was used (or the pre-commit hook silently failed). The
# log makes bypasses auditable; it does not prevent them.
#
# The job is detached + nohup'd so `git commit` returns immediately.

ROOT="$(git rev-parse --show-toplevel)"
LOG_DIR="$ROOT/docs/guardrails"
mkdir -p "$LOG_DIR"

# `;` not `&&` between the two node calls: a non-zero exit from run-gates.mjs
# IS the violation this whole hook exists to catch, and refresh-firing-stats.mjs
# must still run so the violation reaches firing-stats.json (issue #330) --
# `&&` would skip that update on exactly the run that found something.
nohup sh -c "node \"$ROOT/scripts/run-gates.mjs\" --channel pre-commit --continue-on-failure --emit-jsonl docs/guardrails/firing-log.jsonl; node \"$ROOT/scripts/refresh-firing-stats.mjs\"" \
  >>"$LOG_DIR/firing-log.stderr" 2>&1 </dev/null &

exit 0
