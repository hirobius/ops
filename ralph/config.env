# ralph/config.env — per-repo Ralph knobs (checked in; real env vars win).
# ops = PUBLIC repo running client automation (`gh api repos/hirobius/ops --jq
# .private` → false): humans on revenue-path merges, correctness over speed.
# The watchdog's fork-PR guard exists BECAUSE this repo is public — the old
# "PRIVATE" line contradicted the code built on top of it.
RALPH_ITER_TIMEOUT=3600
RALPH_MAX_ATTEMPTS=2
# Failed attempts EVER, across every re-queueing (ops#303). RALPH_MAX_ATTEMPTS
# is scoped to the latest `ralph-ready` labelling on purpose — re-queuing is how
# a human says "I looked, try again" — so it can never bound TOTAL work. This
# does. Deliberately the HIGHER of the two: a no-push iteration is often loop
# infrastructure or an ask-don't-guess stop rather than a bad issue, and a low
# lifetime cap would punish issues for the loop's own defects. Hitting it parks
# until the issue is closed, split, or this number raised — re-queuing will NOT
# clear it.
RALPH_MAX_LIFETIME_ATTEMPTS=5
# Comment length that marks a reasoned stop (ops#303). An iteration that pushed
# no branch but left a comment at least this long is treated as a deliberate
# stop and charged no attempt, even without the `ralph-blocked` sentinel.
RALPH_SUBSTANTIVE_COMMENT_CHARS=120
RALPH_PR_WAIT=1800
RALPH_READY_LABEL=ralph-ready
# Merge policy (ops#238, decided 2026-09-14): a green ralph-gate merges by
# default, EXCEPT a diff touching a supervised revenue path
# (REVENUE_PATH_PREFIXES in scripts/metric-north-star-share.mjs), or the
# boundary's own files (BOUNDARY_SELF_PATHS in scripts/ralph-watchdog.mjs), needs
# RALPH_APPROVE_LABEL on the PR; an unreadable diff never merges unapproved.
# scripts/ralph-watchdog.mjs enforces that on its own (hourly) merge path ONLY.
# The shared engine (hirobius/ralph ralph-gate-reusable.yml@v1) still arms
# auto-merge for an issue tagged RALPH_AUTO_MERGE_LABEL WITHOUT a path check —
# the engine-side check is deferred (ops#238). Until it lands, never tag
# RALPH_AUTO_MERGE_LABEL on an issue whose diff will touch a supervised path.
RALPH_AUTO_MERGE_LABEL=ralph-auto
RALPH_APPROVE_LABEL=ralph-approved
# ops#238 / ops#400: the engine-side path check reads the SAME supervised-path
# set this repo's JS watchdog enforces, via one line per path on stdout —
# never a hand-copied prefix list in a workflow.
RALPH_SUPERVISED_CMD=node scripts/ralph-supervised-paths.mjs
