# ralph/config.env — per-repo Ralph knobs (checked in; real env vars win).
# ops = PRIVATE client automation: human-in-the-loop merges, correctness over speed.
RALPH_ITER_TIMEOUT=3600
RALPH_MAX_ATTEMPTS=2
# Failed attempts EVER, across every re-queueing (ops#303). RALPH_MAX_ATTEMPTS
# is scoped to the latest `ralph-ready` labelling on purpose — re-queuing is how
# a human says "I looked, try again" — so it can never bound TOTAL work. This
# does. Deliberately the HIGHER of the two: a no-push iteration is often loop
# infrastructure or an ask-don't-guess stop rather than a bad issue, and a low
# lifetime cap would punish issues for the loop's own defects. Hitting it parks
# until the issue is closed, split, or this number raised — re-queuing will NOT
# clear it.
RALPH_MAX_LIFETIME_ATTEMPTS=5
# Comment length that marks a reasoned stop (ops#303). An iteration that pushed
# no branch but left a comment at least this long is treated as a deliberate
# stop and charged no attempt, even without the `ralph-blocked` sentinel.
RALPH_SUBSTANTIVE_COMMENT_CHARS=120
RALPH_PR_WAIT=1800
RALPH_READY_LABEL=ralph-ready
# Merge policy (enforced by ralph-gate): a PR auto-merges only when its linked
# issue was pre-tagged RALPH_AUTO_MERGE_LABEL (batch pre-approval) or the PR
# itself gets RALPH_APPROVE_LABEL. Everything else waits for a human.
RALPH_AUTO_MERGE_LABEL=ralph-auto
RALPH_APPROVE_LABEL=ralph-approved
